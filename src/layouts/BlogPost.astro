---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Topbar from '../components/Topbar.astro';
import UnitArticle, { type Statistiques } from '../components/UnitArticle.astro';

// ---------------------------------------------------------------------------
// Disposition des métadonnées. Changer cette seule valeur puis recharger.
//
//   'rails'    Deux rails occupés : métadonnées à gauche, sommaire à droite,
//              texte au centre. Reprend la grille de la page d'accueil.
//   'sobre'    Titre puis une ligne de métadonnées. Colonne centrée, marges
//              vides de part et d'autre.
//   'bandeau'  Le bloc unit en pleine largeur au-dessus du texte.
//
// Le `as Disposition` empêche TypeScript de réduire la constante à son
// littéral, ce qui ferait passer les autres branches pour du code mort.
type Disposition = 'rails' | 'sobre' | 'bandeau';
const DISPOSITION = 'rails' as Disposition;
// ---------------------------------------------------------------------------

type Props = CollectionEntry<'blog'>['data'] & {
	id?: string;
	headings?: MarkdownHeading[];
	statistiques?: Statistiques;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	id,
	headings = [],
	statistiques,
} = Astro.props;

const formatDate = (d: Date | undefined) =>
	d ? d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' }) : '';

const dossier = (id?.split('/').slice(0, -1) ?? []).join('/');

// Seuls les titres de section : au-delà de h3 le sommaire devient un plan
// détaillé, illisible dans un rail étroit.
const sommaire = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<html lang="fr">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Topbar />
		<main>
			<article class="article" data-disposition={DISPOSITION}>
				{
					DISPOSITION === 'rails' && (
						<aside class="rail rail--gauche" aria-label="Informations sur l'article">
							<p class="rail__label"># article</p>
							<UnitArticle
								title={title}
								pubDate={pubDate}
								updatedDate={updatedDate}
								id={id}
								statistiques={statistiques}
							/>
						</aside>
					)
				}

				<div class="article__corps">
					<header class="entete">
						<h1>{title}</h1>

						{
							DISPOSITION === 'sobre' && (
								<p class="meta">
									{dossier && (
										<>
											<span class="meta__cle">dossier</span> {dossier}
											<span class="meta__sep"> · </span>
										</>
									)}
									<span class="meta__cle">publié</span> {formatDate(pubDate)}
									{updatedDate && (
										<>
											<span class="meta__sep"> · </span>
											<span class="meta__cle">mis à jour</span> {formatDate(updatedDate)}
										</>
									)}
								</p>
							)
						}
					</header>

					{
						DISPOSITION === 'bandeau' && (
							<div class="article__fiche">
								<UnitArticle title={title} pubDate={pubDate} updatedDate={updatedDate} id={id} />
							</div>
						)
					}

					{
						heroImage && (
							<div class="article__image">
								<Image width={1020} height={510} src={heroImage} alt="" />
							</div>
						)
					}

					<div class="prose">
						<slot />
					</div>
				</div>

				{
					DISPOSITION === 'rails' && sommaire.length > 0 && (
						<aside class="rail rail--droite" aria-label="Sommaire">
							<p class="rail__label"># sommaire</p>
							<nav class="sommaire">
								{sommaire.map((h) => (
									<a href={`#${h.slug}`} data-niveau={h.depth}>
										{h.text}
									</a>
								))}
							</nav>
						</aside>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* ---------- Dispositions ---------- */
	.article {
		max-width: 46rem;
		margin: 0 auto;
		padding: clamp(2rem, 6vw, 4rem) var(--marge);
	}

	/* Trois colonnes, reprises de la grille de la page d'accueil : un rail en
	   chasse fixe encadre le texte de part et d'autre, ce qui occupe les
	   marges au lieu de les laisser vides. */
	.article[data-disposition='rails'] {
		display: grid;
		/* Bornes basses et hautes plutôt que des largeurs fixes : les rails
		   occupent la place disponible sur un grand écran et se resserrent
		   d'eux-mêmes en dessous, sans étrangler la colonne de texte.
		   Au maximum : 26 + 50 + 19 + 2 × 3,5 de gouttière = 106 rem. */
		grid-template-columns:
			minmax(16rem, 26rem)
			minmax(0, 50rem)
			minmax(12rem, 19rem);
		justify-content: center;
		align-items: start;
		gap: clamp(1.5rem, 3vw, 3.5rem);
		max-width: none;
		padding: clamp(2.5rem, 6vw, 4.5rem) var(--marge);
	}

	.article__corps {
		min-width: 0;
	}

	.article[data-disposition='bandeau'] .article__fiche {
		margin-bottom: 2.5rem;
	}

	/* ---------- Rails ---------- */
	.rail {
		position: sticky;
		top: 5rem;
		font-family: var(--mono);
		font-size: 0.74rem;
		line-height: 1.6;
	}

	.rail__label {
		margin: 0 0 1rem;
		color: var(--signal);
		font-size: 0.78rem;
	}

	.sommaire {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		/* Le sommaire d'un article très découpé ne doit pas dépasser l'écran. */
		max-height: calc(100vh - 9rem);
		overflow-y: auto;
	}

	.sommaire a {
		color: var(--dim);
		text-decoration: none;
		border-left: 1px solid var(--rule);
		padding-left: 0.7rem;
	}

	.sommaire a[data-niveau='3'] {
		padding-left: 1.4rem;
	}

	.sommaire a:hover,
	.sommaire a:focus-visible {
		color: var(--signal);
		border-left-color: var(--signal);
	}

	/* ---------- En-tête ---------- */
	.entete {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--rule);
	}

	.entete h1 {
		margin: 0;
		color: var(--text);
		font-family: var(--display);
		font-weight: 700;
		font-size: clamp(1.9rem, 4vw, 2.8rem);
		line-height: 1.1;
	}

	.meta {
		margin: 1rem 0 0;
		color: var(--dim);
		font-family: var(--mono);
		font-size: 0.76rem;
	}

	.meta__cle {
		color: var(--signal);
	}

	.meta__sep {
		opacity: 0.5;
	}

	.article__image {
		margin-bottom: 2.5rem;
	}

	.article__image :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--rule);
	}

	/* ---------- Corps de l'article ---------- */
	/* Taille remontée avec la largeur de la colonne : à 0,95 rem sur 50 rem,
	   la ligne dépassait 110 caractères, au-delà du confort de lecture.
	   À 1,02 rem elle retombe autour de 95. */
	.prose {
		color: var(--dim);
		font-family: var(--sans);
		font-size: 1.02rem;
		line-height: 1.75;
	}

	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		margin: 2.5rem 0 0.75rem;
		color: var(--text);
		font-family: var(--display);
		line-height: 1.25;
		/* Décale l'ancre sous la barre collante quand on vient du sommaire. */
		scroll-margin-top: 5rem;
	}

	.prose :global(h2) {
		font-size: 1.45rem;
	}

	.prose :global(h3) {
		font-size: 1.15rem;
	}

	.prose :global(a) {
		color: var(--signal);
	}

	.prose :global(strong) {
		color: var(--text);
	}

	.prose :global(code) {
		padding: 0.15em 0.4em;
		border: 1px solid var(--rule);
		background: var(--panel);
		color: var(--text);
		font-family: var(--mono);
		font-size: 0.85em;
	}

	.prose :global(pre) {
		overflow-x: auto;
		margin: 1.5rem 0;
		padding: 1rem;
		border: 1px solid var(--rule);
		font-size: 0.82rem;
		line-height: 1.6;
	}

	/* Le bloc entier porte déjà bordure et fond : les `code` internes ne
	   doivent pas en rajouter une seconde couche. */
	.prose :global(pre code) {
		padding: 0;
		border: 0;
		background: none;
		font-size: inherit;
	}

	.prose :global(blockquote) {
		margin: 1.5rem 0;
		padding-left: 1rem;
		border-left: 2px solid var(--signal);
		color: var(--dim);
		font-style: italic;
	}

	.prose :global(hr) {
		margin: 2.5rem 0;
		border: 0;
		border-top: 1px solid var(--rule);
	}

	.prose :global(img) {
		max-width: 100%;
		height: auto;
		border: 1px solid var(--rule);
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.2rem;
	}

	.prose :global(li) {
		margin: 0.35rem 0;
	}

	.prose :global(li)::marker {
		color: var(--signal);
	}

	.prose :global(table) {
		width: 100%;
		margin: 1.5rem 0;
		border-collapse: collapse;
		font-size: 0.9em;
	}

	.prose :global(th),
	.prose :global(td) {
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--rule);
		text-align: left;
	}

	.prose :global(th) {
		background: var(--panel);
		color: var(--text);
		font-weight: 500;
	}

	.prose :global(> :first-child) {
		margin-top: 0;
	}

	/* Le sommaire part en premier : c'est le plus dispensable des deux rails. */
	@media (max-width: 1320px) {
		.article[data-disposition='rails'] {
			grid-template-columns: 20rem minmax(0, 46rem);
		}

		.rail--droite {
			display: none;
		}
	}

	/* Une seule colonne : la fiche repasse au-dessus du titre. */
	@media (max-width: 1000px) {
		.article[data-disposition='rails'] {
			display: block;
			max-width: 46rem;
			margin: 0 auto;
		}

		.rail--gauche {
			position: static;
			margin-bottom: 2.5rem;
		}
	}
</style>
