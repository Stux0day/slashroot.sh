---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
// `headings` alimente le sommaire latéral de la mise en page.
const { Content, headings } = await render(post);

// Statistiques affichées dans la fiche. Les blocs de code sont retirés du
// comptage : ils gonflent le nombre de mots sans rien dire du temps de
// lecture réel.
const corps = post.body ?? '';
const mots = corps
	.replace(/```[\s\S]*?```/g, ' ')
	.replace(/[#>*_`|[\]()-]/g, ' ')
	.split(/\s+/)
	.filter(Boolean).length;

const statistiques = {
	mots,
	lecture: Math.max(1, Math.round(mots / 200)),
	taille: Buffer.byteLength(corps, 'utf8'),
};
---

<BlogPost {...post.data} id={post.id} headings={headings} statistiques={statistiques}>
	<Content />
</BlogPost>
