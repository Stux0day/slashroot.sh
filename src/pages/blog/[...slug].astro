---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { type Article, dossierDe, statistiques } from '../../lib/articles';
import { parOrdreDAffichage } from '../../lib/tri';

export async function getStaticPaths() {
	const articles = await getCollection('blog');
	return articles.map((article) => {
		// Voisins dans l'ordre d'affichage du dossier (src/lib/tri.ts).
		const freres = articles
			.filter((autre) => dossierDe(autre) === dossierDe(article))
			.sort(parOrdreDAffichage);
		const rang = freres.findIndex((autre) => autre.id === article.id);
		return {
			params: { slug: article.id },
			props: { article, freres, precedent: freres[rang - 1], suivant: freres[rang + 1] },
		};
	});
}

interface Props {
	article: Article;
	/** Articles du même dossier, pour le rail de gauche. */
	freres: Article[];
	precedent?: Article;
	suivant?: Article;
}

const { article, freres, precedent, suivant } = Astro.props;
// `headings` alimente le sommaire.
const { Content, headings } = await render(article);
---

<ArticleLayout
	article={article}
	titres={headings}
	statistiques={statistiques(article)}
	freres={freres}
	precedent={precedent}
	suivant={suivant}
>
	<Content />
</ArticleLayout>
