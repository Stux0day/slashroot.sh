---
// Page listant tous les articles d'un dossier de la barre supérieure.
// Cible de la ligne « + n autre(s) » du menu déroulant : ce menu se limite à
// MAX_PAR_LISTE articles (voir Topbar.astro), cette page montre le reste.
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import ListeArticles from '../../../components/ListeArticles.astro';
import Topbar from '../../../components/Topbar.astro';
import { SITE_TITLE } from '../../../consts';
import { dossiers as dossiersDeclares } from '../../../data/site';
import { parOrdreDAffichage } from '../../../lib/tri';

export async function getStaticPaths() {
	const articles = await getCollection('blog');
	const ids = new Set(articles.map((article) => article.id.split('/')[0]));

	return [...ids].map((dossier) => ({
		params: { dossier },
		props: {
			articles: articles
				.filter((article) => article.id.split('/')[0] === dossier)
				.sort(parOrdreDAffichage),
		},
	}));
}

type Props = { articles: CollectionEntry<'blog'>[] };

const { dossier } = Astro.params;
const { articles } = Astro.props;

const libelle = dossiersDeclares.find((d) => d.id === dossier)?.libelle ?? dossier;
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title={`${libelle} — articles — ${SITE_TITLE}`}
			description={`Tous les articles du dossier ${libelle}.`}
		/>
	</head>

	<body>
		<Topbar />
		<main>
			<header class="entete">
				<p class="rail__label"># dossier</p>
				<h1>{libelle}</h1>
			</header>

			<ListeArticles articles={articles} />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 46rem;
		margin: 0 auto;
		padding: clamp(2.5rem, 6vw, 4.5rem) var(--marge);
	}

	.entete {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--rule);
	}

	.rail__label {
		margin: 0 0 0.75rem;
		color: var(--signal);
		font-family: var(--mono);
		font-size: 0.78rem;
	}

	.entete h1 {
		margin: 0;
		color: var(--text);
		font-family: var(--display);
		font-weight: 700;
		font-size: clamp(1.6rem, 3.5vw, 2.2rem);
		line-height: 1.1;
	}
</style>
