---
// Page listant tous les articles d'un dossier de la barre supérieure.
// Cible de la ligne « + n autre(s) » du menu déroulant : ce menu se limite à
// MAX_PAR_LISTE articles (voir Topbar.astro), cette page montre le reste.
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Topbar from '../../../components/Topbar.astro';
import { dossiers as dossiersDeclares } from '../../../data/site';

export async function getStaticPaths() {
	const articles = await getCollection('blog');
	const ids = new Set(articles.map((article) => article.id.split('/')[0]));

	return [...ids].map((dossier) => ({
		params: { dossier },
		props: {
			articles: articles
				.filter((article) => article.id.split('/')[0] === dossier)
				.sort((a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0)),
		},
	}));
}

type Props = { articles: CollectionEntry<'blog'>[] };

const { dossier } = Astro.params;
const { articles } = Astro.props;

const libelle = dossiersDeclares.find((d) => d.id === dossier)?.libelle ?? dossier;

// os/Debian/x -> « Debian/ » ; systeme/apache -> pas de sous-dossier.
const sousDossier = (id: string) => {
	const segments = id.split('/');
	return segments.length > 2 ? `${segments[1]}/` : null;
};
---

<html lang="fr">
	<head>
		<BaseHead title={`${libelle} — articles`} description={`Tous les articles du dossier ${libelle}.`} />
	</head>

	<body>
		<Topbar />
		<main>
			<header class="entete">
				<p class="rail__label"># dossier</p>
				<h1>{libelle}</h1>
			</header>

			<ul class="liste">
				{
					articles.map((article) => (
						<li class="ligne">
							<a href={`/blog/${article.id}/`}>
								{sousDossier(article.id) && <span class="sous">{sousDossier(article.id)}</span>}
								<span class="titre">{article.data.title}</span>
							</a>
							<span class="date">
								<FormattedDate date={article.data.pubDate} />
							</span>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 46rem;
		margin: 0 auto;
		padding: clamp(2.5rem, 6vw, 4.5rem) var(--marge);
	}

	.entete {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--rule);
	}

	.rail__label {
		margin: 0 0 0.75rem;
		color: var(--signal);
		font-family: var(--mono);
		font-size: 0.78rem;
	}

	.entete h1 {
		margin: 0;
		color: var(--text);
		font-family: var(--display);
		font-weight: 700;
		font-size: clamp(1.6rem, 3.5vw, 2.2rem);
		line-height: 1.1;
	}

	.liste {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.ligne {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--rule);
	}

	.ligne a {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		min-width: 0;
		color: var(--text);
		text-decoration: none;
	}

	.ligne a:hover,
	.ligne a:focus-visible {
		color: var(--signal);
	}

	.sous {
		flex: none;
		color: var(--dim);
		font-family: var(--mono);
		font-size: 0.82rem;
	}

	.titre {
		overflow: hidden;
		font-family: var(--sans);
		font-size: 1.02rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.date {
		flex: none;
		color: var(--dim);
		font-family: var(--mono);
		font-size: 0.78rem;
	}

	@media (max-width: 600px) {
		.ligne {
			flex-direction: column;
			gap: 0.35rem;
		}
	}
</style>
