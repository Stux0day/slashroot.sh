---
// Page d'un dossier : tous ses articles, rangés par sous-dossier, puis des
// raccourcis vers les autres dossiers.
import FilAriane from '../../../components/FilAriane.astro';
import GroupesArticles from '../../../components/GroupesArticles.astro';
import PucesDossiers from '../../../components/PucesDossiers.astro';
import Tiret from '../../../components/Tiret.astro';
import { SITE_TITLE } from '../../../consts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { chargerDossiers, type Dossier } from '../../../lib/articles';

export async function getStaticPaths() {
	const dossiers = await chargerDossiers();
	return dossiers.map((dossier) => ({
		params: { dossier: dossier.id },
		props: {
			dossier,
			autres: dossiers
				.filter((d) => d.id !== dossier.id)
				.map((d) => ({ id: d.id, libelle: d.libelle, total: d.articles.length })),
		},
	}));
}

interface Props {
	dossier: Dossier;
	autres: { id: string; libelle: string; total: number }[];
}

const { dossier, autres } = Astro.props;
const total = dossier.articles.length;
const sousDossiers = dossier.groupes.flatMap((g) => (g.nom ? [g.nom] : []));
---

<BaseLayout
	title={`${dossier.libelle} — Articles — ${SITE_TITLE}`}
	description={`Les ${total} articles du dossier ${dossier.libelle}.`}
>
	<header class="page-entete conteneur">
		<FilAriane
			etapes={[
				{ texte: 'Accueil', href: '/' },
				{ texte: 'Articles', href: '/blog/' },
				{ texte: dossier.libelle },
			]}
		/>
		<h1 class="page-titre"><Tiret texte={dossier.libelle} /></h1>
		<p class="page-chapo">
			{total} article{total > 1 ? 's' : ''}{sousDossiers.length > 0 && ` · ${sousDossiers.join(', ')}`}
		</p>
	</header>

	<section class="bloc bloc--serre conteneur" aria-label="Articles du dossier">
		<GroupesArticles groupes={dossier.groupes} />
	</section>

	{
		autres.length > 0 && (
			<nav class="bloc bloc--dernier conteneur" aria-labelledby="autres-titre">
				<h2 class="autres__titre etiquette" id="autres-titre">
					Autres dossiers
				</h2>
				<PucesDossiers etiquette="Autres dossiers" dossiers={autres} />
			</nav>
		)
	}
</BaseLayout>

<style>
	.bloc--serre {
		padding-top: clamp(2.5rem, 5vw, 4rem);
	}

	.autres__titre {
		margin-bottom: 1rem;
		padding-top: 1rem;
		border-top: 2px solid var(--encre);
	}
</style>
