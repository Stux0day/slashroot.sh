---
// Index des articles : tous les dossiers sur une page, chacun rangé par
// sous-dossier. L'ordre des dossiers vient de src/data/site.ts, celui des
// articles de src/lib/tri.ts.
import FilAriane from '../../components/FilAriane.astro';
import GroupesArticles from '../../components/GroupesArticles.astro';
import PucesDossiers from '../../components/PucesDossiers.astro';
import TitreSection from '../../components/TitreSection.astro';
import { SITE_TITLE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { chargerDossiers, numero } from '../../lib/articles';

const dossiers = await chargerDossiers();
const total = dossiers.reduce((somme, dossier) => somme + dossier.articles.length, 0);
const pluriel = (n: number, mot: string) => `${n} ${mot}${n > 1 ? 's' : ''}`;
---

<BaseLayout
	title={`Articles — ${SITE_TITLE}`}
	description={`${total} notes techniques : systèmes, réseaux, virtualisation et automatisation.`}
>
	<header class="page-entete conteneur">
		<FilAriane etapes={[{ texte: 'Accueil', href: '/' }, { texte: 'Articles' }]} />
		<h1 class="page-titre">Articles</h1>
		<p class="page-chapo">
			{pluriel(total, 'note')} technique{total > 1 ? 's' : ''}, rangée{total > 1 ? 's' : ''} en {pluriel(dossiers.length, 'dossier')}.
		</p>
		<div class="raccourcis">
			<PucesDossiers
				etiquette="Aller à un dossier"
				ancres
				dossiers={dossiers.map((d) => ({ id: d.id, libelle: d.libelle, total: d.articles.length }))}
			/>
		</div>
	</header>

	{
		dossiers.map((dossier, i) => (
			<section
				class:list={['bloc conteneur', { 'bloc--dernier': i === dossiers.length - 1 }]}
				id={dossier.id}
				aria-labelledby={`titre-${dossier.id}`}
			>
				<TitreSection
					numero={numero(i + 1)}
					titre={dossier.libelle}
					id={`titre-${dossier.id}`}
					note={pluriel(dossier.articles.length, 'article')}
					lien={{ href: `/blog/${dossier.id}/`, texte: 'Ouvrir le dossier' }}
				/>
				<GroupesArticles groupes={dossier.groupes} />
			</section>
		))
	}
</BaseLayout>

<style>
	.raccourcis {
		margin-top: clamp(2rem, 4vw, 3rem);
	}
</style>
