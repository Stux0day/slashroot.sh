---
// src/pages/index.astro
// Page d'accueil autonome : aucune dépendance à un layout existant.
// Tu pourras extraire le <head> dans src/layouts/ plus tard.

import { Font } from 'astro:assets';

import Bruit from '../components/Bruit.astro';
import Footer from '../components/Footer.astro';
import ThemeScript from '../components/ThemeScript.astro';
import Topbar from '../components/Topbar.astro';

// --- Contenu éditorial : voir src/data/site.ts --------------------------
import { banniere, certifs, identite, stack, travaux } from '../data/site';

// Jetons de thème, reset et boutons : source unique.
import '../styles/global.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{identite.nom} — {identite.role}</title>
    <meta
      name="description"
      content="Portfolio d'un administrateur systèmes et infrastructure : Linux, Terraform, gestion de secrets, supervision."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@600;700&family=IBM+Plex+Sans:wght@400;500&display=swap"
      rel="stylesheet"
    />

    {/* Cette page a son propre <head> et ne passe pas par BaseHead : ses
        polices se déclarent donc ici. VT323 pour la bannière, Rubik Glitch pour
        la barre supérieure. */}
    <Font cssVariable="--font-vt323" preload />
    <Font cssVariable="--font-rubik-glitch" preload />

    <ThemeScript />
  </head>

  <body>
    <Topbar />

    <main>
      <!-- HERO : titre en police pixel à gauche, sortie systemctl à droite -->
      <section class="hero">
        <div class="hero__titre">
          <p class="banniere__intro">
            <span class="banniere__ponct">//</span>
            {banniere.intro}
          </p>
          <h1 class="banniere__titre">
            <span class="banniere__ponct" aria-hidden="true">{'{"'}</span>
            {banniere.titre}
            <span class="banniere__ponct" aria-hidden="true">{'"}'}</span>
          </h1>
          <Bruit />
          <div class="hero__actions">
            <a class="btn btn--primaire" href="/cv.pdf">Télécharger le CV</a>
          </div>
        </div>

        <div class="unit" role="img" aria-label={`Statut : ${identite.role}, ${identite.statut}`}>
          <div class="unit__barre">
            <span class="unit__prompt">$</span> systemctl status {identite.service}
          </div>
          <pre class="unit__sortie"><span class="ln"><span class="dot" aria-hidden="true"></span> <b>{identite.service}</b> — {identite.role}</span>
<span class="ln">     Loaded: <span class="v">loaded</span> (/etc/systemd/system/{identite.service}; <span class="v">enabled</span>)</span>
<span class="ln">     Active: <span class="live">active (running)</span> since {identite.depuis}</span>
<span class="ln">   Location: <span class="v">{identite.ville}</span></span>
<span class="ln">     Status: <span class="v">"{identite.statut}"</span></span>
<span class="ln">      Tasks: <span class="v">infra, automatisation, sécurité, observabilité</span></span></pre>
        </div>
      </section>

      <!-- STACK : structure clé/valeur, comme un fichier de configuration -->
      <section id="stack" class="bloc">
        <p class="bloc__label"># stack</p>
        <div class="bloc__corps">
          <dl class="conf">
            {
              stack.map((ligne) => (
                <div class="conf__ligne">
                  <dt>{ligne.cle}</dt>
                  <dd>{ligne.valeur}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- TRAVAUX -->
      <section id="travaux" class="bloc">
        <p class="bloc__label"># travaux</p>
        <div class="bloc__corps">
          <div class="grille">
            {
              travaux.map((t) => (
                <article class="panneau">
                  <h2>{t.titre}</h2>
                  <p>{t.resume}</p>
                  <ul class="tags">
                    {t.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      {/* CERTIFS : trois zones par ligne — année, intitulé, organisme en
          pastille. La section a d'abord réutilisé la grille clé/valeur du
          stack, mais celle-ci réserve 12rem à la clé, ce qui creusait un vide
          entre « 2025 » et le titre, et noyait l'organisme derrière un tiret
          dans la même coulée de mono. Ici l'intitulé porte l'information et
          passe en police de titrage ; l'année et l'organisme l'encadrent en
          chasse fixe, de part et d'autre.

          La section disparaît tant que src/data/site.ts n'en déclare aucune —
          un bloc vide vaut moins que pas de bloc. */}
      {
        certifs.length > 0 && (
          <section id="certifs" class="bloc">
            <p class="bloc__label"># certifs</p>
            <div class="bloc__corps">
              <ul class="certifs">
                {certifs.map((c) => (
                  <li class="certif">
                    <span class="certif__annee">{c.annee}</span>
                    <span class="certif__organisme">{c.organisme}</span>
                    <span class="certif__intitule">
                      {c.lien ? (
                        <a href={c.lien} rel="noopener">
                          {c.intitule}
                        </a>
                      ) : (
                        c.intitule
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )
      }
    </main>

    <Footer />

    <style is:global>
      /* Jetons, reset, .btn : voir src/styles/global.css */

      /* ---------- Titre du hero ---------- */
      /* Seul endroit du site en VT323 : une police pixel n'a qu'une graisse
         et fatigue vite en lecture suivie, mais elle porte bien un titre.
         Tailles calées sur une demi-largeur, le titre partageant la ligne
         avec le bloc systemctl. */
      .banniere__intro {
        margin: 0 0 0.15em;
        color: var(--signal);
        font-family: var(--font-vt323), var(--mono);
        font-size: clamp(1rem, 1.8vw, 1.5rem);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .banniere__titre {
        margin: 0;
        color: var(--signal);
        font-family: var(--font-vt323), var(--mono);
        font-weight: 400;
        font-size: clamp(2.2rem, 5vw, 4.2rem);
        line-height: 1;
        letter-spacing: 0.02em;
      }

      /* Accolades, guillemets et « // » : ponctuation de code, en retrait
         pour que le texte reste ce qu'on lit en premier. */
      .banniere__ponct {
        color: var(--dim);
      }

      /* ---------- Hero ---------- */
      .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
        padding: clamp(3.5rem, 9vw, 7rem) var(--marge);
        border-bottom: 1px solid var(--rule);
      }

      /* Sans min-width, une ligne de bruit trop longue élargirait la colonne
         au lieu d'être rognée, et déséquilibrerait la grille. */
      .hero__titre {
        min-width: 0;
      }

      .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
      }

      /* ---------- Blocs de section ---------- */
      .bloc {
        display: grid;
        grid-template-columns: var(--rail) 1fr;
        gap: 2rem;
        padding: clamp(2.5rem, 6vw, 4.5rem) var(--marge);
        border-bottom: 1px solid var(--rule);
      }

      .bloc__label {
        margin: 0;
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--signal);
      }

      .bloc__corps {
        min-width: 0;
      }

      /* ---------- Lignes de configuration ---------- */
      .conf {
        margin: 0;
        border-top: 1px solid var(--rule);
      }

      .conf__ligne {
        display: grid;
        grid-template-columns: 12rem 1fr;
        gap: 1rem;
        padding: 0.85rem 0;
        border-bottom: 1px solid var(--rule);
      }

      .conf dt {
        font-family: var(--mono);
        font-size: 0.82rem;
        color: var(--dim);
      }

      .conf dd {
        margin: 0;
        font-family: var(--mono);
        font-size: 0.85rem;
      }

      .conf dd a {
        color: var(--text);
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
      }

      .conf dd a:hover {
        color: var(--signal);
        border-color: var(--signal);
      }

      /* ---------- Panneaux de travaux ---------- */
      .grille {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
        gap: 1px;
        background: var(--rule);
        border: 1px solid var(--rule);
      }

      .panneau {
        padding: 1.5rem;
        background: var(--panel);
        border-left: 2px solid transparent;
        transition: border-color 0.15s ease;
      }

      .panneau:hover {
        border-left-color: var(--signal);
      }

      .panneau h2 {
        margin: 0 0 0.75rem;
        font-family: var(--display);
        font-size: 1.15rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .panneau p {
        margin: 0 0 1.25rem;
        font-size: 0.92rem;
        color: var(--dim);
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .tags li {
        padding: 0.2rem 0.55rem;
        border: 1px solid var(--rule);
        font-family: var(--mono);
        font-size: 0.7rem;
        color: var(--dim);
      }

      /* ---------- Certifications ---------- */
      /* Les colonnes sont portées par la liste, pas par chaque ligne : une
         grille par <li> se dimensionnerait sur son seul contenu, et la pastille
         « PeopleCert » décalerait son intitulé par rapport à ceux des lignes
         « AWS ». C'est la liste qui définit les trois pistes, et chaque ligne
         s'y raccorde en `subgrid` — ce qui conserve la boîte du <li>, donc son
         filet de séparation, tout en partageant les colonnes. */
      .certifs {
        display: grid;
        grid-template-columns: auto auto 1fr;
        column-gap: 1.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--rule);
      }

      /* Les deux métadonnées ouvrent la ligne — année puis organisme — et
         l'intitulé prend tout le reste. Les pastilles se retrouvent en colonne
         alignée, ce qui rend les répétitions visibles (trois AWS, deux GCP)
         sans avoir à regrouper les entrées, et l'année sert de repère
         chronologique au fer à gauche. */
      .certif {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
        align-items: center;
        padding: 0.9rem 0;
        border-bottom: 1px solid var(--rule);
      }

      /* Chiffres à chasse fixe : sans ça, les années ne s'alignent pas
         verticalement d'une ligne à l'autre dans les polices à chiffres
         proportionnels. */
      .certif__annee {
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--dim);
        font-variant-numeric: tabular-nums;
      }

      /* C'est l'intitulé qui porte l'information, il passe donc en police de
         titrage plutôt qu'en chasse fixe — le reste de la ligne est du
         métadonnée et garde le mono. */
      .certif__intitule {
        font-family: var(--display);
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.3;
        color: var(--text);
      }

      .certif__intitule a {
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
      }

      .certif__intitule a:hover {
        color: var(--signal);
        border-color: var(--signal);
      }

      /* Même pastille que les tags des travaux : l'organisme est de même
         nature qu'un tag, il en reprend le dessin. `stretch` plutôt que
         `start` : la sous-grille donne à la colonne la largeur du plus long
         organisme, toutes les pastilles la remplissent donc et forment un bord
         droit net au lieu d'une colonne en dents de scie. Texte centré. */
      .certif__organisme {
        justify-self: stretch;
        padding: 0.2rem 0.55rem;
        border: 1px solid var(--rule);
        font-family: var(--mono);
        font-size: 0.7rem;
        color: var(--dim);
        text-align: center;
        white-space: nowrap;
      }

      /* ---------- Adaptatif ---------- */
      @media (max-width: 900px) {
        .hero {
          grid-template-columns: 1fr;
        }

        .bloc {
          grid-template-columns: 1fr;
          gap: 1.25rem;
        }
      }

      @media (max-width: 640px) {
        .conf__ligne {
          grid-template-columns: 1fr;
        }

        /* Trois zones sur une ligne ne tiennent plus : l'année et l'organisme
           forment un bandeau de métadonnées, l'intitulé passe dessous sur toute
           la largeur. On sort de la sous-grille — les colonnes n'ont plus à
           être communes puisqu'il n'y en a plus qu'une. `start` sur la dernière
           piste évite que la pastille ne soit étirée jusqu'au bord droit. */
        .certifs {
          grid-template-columns: 1fr;
        }

        .certif {
          grid-column: 1;
          grid-template-columns: auto 1fr;
          gap: 0.45rem 0.9rem;
        }

        .certif__organisme {
          justify-self: start;
        }

        .certif__intitule {
          grid-column: 1 / -1;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        .ln,
        .dot {
          animation: none;
          opacity: 1;
        }
      }
    </style>

  </body>
</html>