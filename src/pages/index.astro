---
// Page d'accueil. Tout le texte vient de src/data/site.ts : ce fichier ne fait
// que la mise en page.
import { getCollection } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Icon from '../components/Icon.astro';
import ListeArticles from '../components/ListeArticles.astro';
import Tiret from '../components/Tiret.astro';
import TitreSection from '../components/TitreSection.astro';
import { SITE_DESCRIPTION } from '../consts';
import { banniere, certifs, contact, identite, stack, travaux } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { chargerDossiers, numero, parDateDecroissante } from '../lib/articles';
import { nomProfil } from '../lib/profils';

const articles = await getCollection('blog');
const recents = [...articles].sort(parDateDecroissante).slice(0, 6);
const dossiers = await chargerDossiers();
const nbOutils = stack.reduce((total, ligne) => total + ligne.outils.length, 0);

// Le bouton « Télécharger le CV » n'apparaît que si le fichier existe : un lien
// mort en tête de page coûte plus qu'un bouton absent. Déposer le PDF dans
// public/cv.pdf pour le faire apparaître.
const cvPresent = existsSync(join(process.cwd(), 'public', 'cv.pdf'));

const chiffres = [
	{ valeur: articles.length, libelle: 'articles', href: '/blog/' },
	{ valeur: dossiers.length, libelle: 'dossiers', href: '/blog/' },
	{ valeur: nbOutils, libelle: 'outils', href: '#stack' },
	...(certifs.length > 0 ? [{ valeur: certifs.length, libelle: 'certifications', href: '#certifs' }] : []),
];

// Les sections sont numérotées dans leur ordre d'affichage : si une section
// disparaît (certifications vides), la numérotation reste continue.
let section = 0;
const prochaineSection = () => numero(++section);
---

<BaseLayout title={`${identite.nom} — ${identite.role}`} description={SITE_DESCRIPTION}>
	<section class="hero conteneur" aria-labelledby="hero-titre">
		<p class="hero__intro etiquette">{banniere.intro.trim()}</p>
		<h1 class="hero__titre" id="hero-titre"><Tiret texte={banniere.titre} /></h1>

		<div class="hero__bas">
			<div class="hero__presentation">
				<p class="hero__chapo">
					{identite.nom} — {identite.role.toLowerCase()} depuis {identite.depuis}, basé à {identite.ville}.
				</p>
				<ul class="hero__domaines" role="list">
					{identite.domaines.map((domaine) => <li>{domaine}</li>)}
				</ul>
				<div class="hero__actions">
					{
						cvPresent && (
							<a class="btn btn--plein" href="/cv.pdf" download>
								<Icon nom="telecharger" />
								Télécharger le CV
							</a>
						)
					}
					<a class:list={['btn', { 'btn--plein': !cvPresent }]} href="/blog/">
						Lire les articles
						<Icon nom="fleche-droite" />
					</a>
				</div>
			</div>

			<aside class="fiche" aria-labelledby="fiche-titre">
				<h2 class="fiche__titre etiquette" id="fiche-titre">
					<span>Fiche</span>
					<span>{identite.service}</span>
				</h2>
				<dl>
					<div>
						<dt class="etiquette">Nom</dt>
						<dd>{identite.nom}</dd>
					</div>
					<div>
						<dt class="etiquette">Rôle</dt>
						<dd>{identite.role}</dd>
					</div>
					<div>
						<dt class="etiquette">Depuis</dt>
						<dd>{identite.depuis}</dd>
					</div>
					<div>
						<dt class="etiquette">Lieu</dt>
						<dd>{identite.ville}</dd>
					</div>
					<div>
						<dt class="etiquette">Statut</dt>
						<dd><span class="fiche__pastille" aria-hidden="true"></span>{identite.statut}</dd>
					</div>
					<div>
						<dt class="etiquette">Profils</dt>
						<dd class="fiche__profils">
							{
								contact.map((ligne) => (
									<a href={ligne.lien} rel="me noopener">
										{nomProfil(ligne.cle)}
										<Icon nom="fleche-diag" taille={14} />
									</a>
								))
							}
						</dd>
					</div>
				</dl>
			</aside>
		</div>
	</section>

	<div class="conteneur">
		<ul class="chiffres" role="list">
			{
				chiffres.map((chiffre) => (
					<li>
						<a class="chiffre" href={chiffre.href}>
							<span class="chiffre__valeur">{chiffre.valeur}</span>
							<span class="chiffre__libelle etiquette">{chiffre.libelle}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>

	<section class="bloc conteneur" id="stack" aria-labelledby="titre-stack">
		<TitreSection
			numero={prochaineSection()}
			titre="Compétences"
			id="titre-stack"
			note={`${stack.length} domaines · ${nbOutils} outils`}
		/>
		<ol class="competences" role="list">
			{
				stack.map((ligne, i) => (
					<li class="competence">
						<span class="competence__numero etiquette" aria-hidden="true">
							{numero(i + 1)}
						</span>
						<h3 class="competence__domaine">{ligne.domaine}</h3>
						<ul class="competence__outils" role="list">
							{ligne.outils.map((outil) => (
								<li class="puce">{outil}</li>
							))}
						</ul>
					</li>
				))
			}
		</ol>
	</section>

	<section class="bloc conteneur" id="travaux" aria-labelledby="titre-travaux">
		<TitreSection numero={prochaineSection()} titre="Réalisations" id="titre-travaux" />
		<ol class="travaux" role="list">
			{
				travaux.map((travail, i) => (
					<li class="travail">
						<span class="travail__numero" aria-hidden="true">
							{numero(i + 1)}
						</span>
						<h3 class="travail__titre">{travail.titre}</h3>
						<p class="travail__resume">{travail.resume}</p>
						<ul class="travail__tags" role="list">
							{travail.tags.map((tag) => (
								<li class="puce">{tag}</li>
							))}
						</ul>
					</li>
				))
			}
		</ol>
	</section>

	{
		certifs.length > 0 && (
			<section class="bloc conteneur" id="certifs" aria-labelledby="titre-certifs">
				<TitreSection numero={prochaineSection()} titre="Certifications" id="titre-certifs" />
				<ul class="certifs" role="list">
					{certifs.map((certif) => (
						<li class="certif">
							<span class="certif__annee">{certif.annee}</span>
							<span class="certif__intitule">
								{certif.lien ? (
									<a href={certif.lien} rel="noopener">
										{certif.intitule}
									</a>
								) : (
									certif.intitule
								)}
							</span>
							<span class="certif__organisme puce">{certif.organisme}</span>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section class="bloc bloc--dernier conteneur" id="articles" aria-labelledby="titre-articles">
		<TitreSection
			numero={prochaineSection()}
			titre="Derniers articles"
			id="titre-articles"
			lien={{ href: '/blog/', texte: `Les ${articles.length} articles` }}
		/>
		<ListeArticles articles={recents} avecDossier />
	</section>
</BaseLayout>

<style>
	/* ---------- Ouverture ---------- */
	.hero {
		padding-block: clamp(2.5rem, 7vw, 6.5rem) clamp(2.5rem, 5vw, 4.5rem);
	}

	.hero__intro {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
		color: var(--encre-2);
		text-transform: none;
		letter-spacing: 0.02em;
		font-size: var(--t-s);
	}

	.hero__intro::before {
		content: '';
		flex: none;
		width: 2.5rem;
		height: 2px;
		background: var(--accent);
	}

	.hero__titre {
		margin-left: -0.05em;
		font-size: var(--t-geant);
		font-variation-settings: var(--etire);
		font-weight: 900;
		line-height: 0.86;
		letter-spacing: -0.04em;
	}

	.hero__bas {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--colonnes-gap);
		row-gap: 3rem;
		margin-top: clamp(2.5rem, 5vw, 4.5rem);
		padding-top: clamp(1.25rem, 2.5vw, 2rem);
		border-top: 2px solid var(--encre);
	}

	.hero__presentation {
		grid-column: 1 / span 6;
	}

	.hero__chapo {
		max-width: 30ch;
		font-size: var(--t-2xl);
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.015em;
	}

	.hero__domaines {
		display: flex;
		flex-wrap: wrap;
		margin-top: 1.5rem;
		font-family: var(--police-mono);
		font-size: var(--t-s);
		color: var(--encre-2);
	}

	/* Séparateur posé après chaque domaine sauf le dernier : à la coupure de
	   ligne, la barre reste en fin de ligne au lieu d'ouvrir la suivante. */
	.hero__domaines li:not(:last-child)::after {
		content: '/';
		margin-inline: 0.65em;
		color: var(--accent);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: clamp(2rem, 4vw, 2.75rem);
	}

	/* Fiche d'identité, à la manière d'une fiche technique. */
	.fiche {
		grid-column: 8 / -1;
		align-self: start;
		border: 1px solid var(--filet);
		border-top: 2px solid var(--encre);
	}

	.fiche__titre {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 1.25rem;
		border-bottom: 1px solid var(--filet);
		color: var(--encre);
	}

	.fiche__titre span:last-child {
		color: var(--encre-3);
		text-transform: none;
		letter-spacing: 0;
	}

	.fiche dl > div {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr);
		gap: 1rem;
		align-items: baseline;
		padding: 0.8rem 1.25rem;
	}

	.fiche dl > div + div {
		border-top: 1px solid var(--filet);
	}

	.fiche dd {
		font-weight: 600;
	}

	.fiche__pastille {
		display: inline-block;
		width: 0.6rem;
		height: 0.6rem;
		margin-right: 0.55rem;
		border-radius: 50%;
		background: var(--dispo);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--dispo) 22%, transparent);
	}

	.fiche__profils {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
	}

	.fiche__profils a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		text-decoration: none;
		transition: color var(--duree) var(--courbe);
	}

	.fiche__profils a:hover {
		color: var(--accent-texte);
	}

	/* ---------- Chiffres clés ---------- */
	.chiffres {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
		gap: 1px;
		margin: 0;
		border-block: 1px solid var(--filet);
		background: var(--filet);
	}

	.chiffre {
		display: grid;
		gap: 0.35rem;
		height: 100%;
		padding: 1.25rem 1.25rem 1.4rem;
		background: var(--papier);
		text-decoration: none;
		transition: background-color var(--duree) var(--courbe);
	}

	.chiffre:hover {
		background: var(--accent-voile);
	}

	.chiffre__valeur {
		font-size: var(--t-3xl);
		font-variation-settings: var(--etire);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
	}

	.chiffre:hover .chiffre__valeur {
		color: var(--accent);
	}

	/* ---------- Compétences ---------- */
	.competences {
		margin: 0;
		border-bottom: 1px solid var(--filet);
	}

	.competence {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--colonnes-gap);
		row-gap: 1rem;
		align-items: baseline;
		padding-block: 1.6rem;
		border-top: 1px solid var(--filet);
	}

	/* Gris et non rouge : le rouge reste au numéro de section, juste au-dessus. */
	.competence__numero {
		grid-column: 1 / span 2;
	}

	.competence__domaine {
		grid-column: 3 / span 3;
		font-size: var(--t-l);
		font-variation-settings: var(--etire-mi);
		font-weight: 750;
		line-height: 1.2;
	}

	.competence__domaine::first-letter {
		text-transform: uppercase;
	}

	.competence__outils {
		display: flex;
		flex-wrap: wrap;
		grid-column: 6 / -1;
		gap: 0.5rem;
		margin: 0;
	}

	.competence__outils .puce {
		font-size: var(--t-s);
	}

	/* ---------- Réalisations ---------- */
	.travaux {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
		gap: clamp(2.5rem, 4vw, 3rem) var(--colonnes-gap);
		margin: 0;
	}

	.travail {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-top: 1rem;
		border-top: 2px solid var(--encre);
	}

	.travail__numero {
		margin-bottom: 0.5rem;
		color: var(--accent);
		font-size: var(--t-3xl);
		font-variation-settings: var(--etire);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.travail__titre {
		font-size: var(--t-xl);
		font-weight: 750;
		line-height: 1.15;
	}

	.travail__resume {
		color: var(--encre-2);
	}

	.travail__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: auto;
		padding-top: 0.5rem;
	}

	/* ---------- Certifications ---------- */
	.certifs {
		margin: 0;
		border-top: 1px solid var(--filet);
	}

	.certif {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--colonnes-gap);
		row-gap: 0.5rem;
		align-items: baseline;
		padding-block: 1.1rem;
		border-bottom: 1px solid var(--filet);
		transition: background-color var(--duree) var(--courbe);
	}

	.certif:hover {
		background: var(--accent-voile);
	}

	.certif__annee {
		grid-column: 1 / span 2;
		font-family: var(--police-mono);
		font-size: var(--t-s);
		font-variant-numeric: tabular-nums;
		color: var(--encre-3);
	}

	.certif__intitule {
		grid-column: 3 / span 7;
		font-size: var(--t-l);
		font-weight: 650;
		line-height: 1.3;
	}

	.certif__intitule a {
		text-decoration-color: var(--filet);
	}

	.certif__intitule a:hover {
		color: var(--accent-texte);
		text-decoration-color: currentColor;
	}

	.certif__organisme {
		grid-column: 10 / -1;
		justify-self: end;
	}

	/* ---------- Adaptations ---------- */
	@media (max-width: 64rem) {
		.hero__presentation,
		.fiche {
			grid-column: 1 / -1;
		}

		.competence__domaine {
			grid-column: 3 / -1;
		}

		.competence__outils {
			grid-column: 3 / -1;
		}
	}

	@media (max-width: 40rem) {
		.competence__numero,
		.competence__domaine,
		.competence__outils {
			grid-column: 1 / -1;
		}

		.fiche dl > div {
			grid-template-columns: 6rem minmax(0, 1fr);
			padding-inline: 1rem;
		}

		.certif__annee {
			grid-column: 1 / span 6;
		}

		.certif__organisme {
			grid-column: 7 / -1;
		}

		.certif__intitule {
			grid-column: 1 / -1;
			grid-row: 2;
		}
	}
</style>
