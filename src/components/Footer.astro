---
// Pied de page commun. Reprend celui de la page d'accueil : les pages du blog
// affichaient encore le gabarit Astro d'origine (« Your name here » et les
// liens sociaux du projet Astro).
//
// Depuis le retrait de la section #contact de l'accueil, c'est le seul endroit
// du site où l'on peut joindre l'auteur — d'où sa présence sur toutes les
// pages plutôt que sur la seule page d'accueil.
import { contact, identite } from '../data/site';

// Marques GitHub et LinkedIn, tracés officiels sur une grille de 24. Inlinées
// plutôt que chargées : deux fichiers de plus pour 400 octets de dessin ne
// valent pas leurs requêtes, et en inline elles héritent de `currentColor`,
// donc du thème, sans qu'on ait à maintenir une variante par mode.
const LOGOS: Record<string, string> = {
  github:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
};

// Un libellé sans majuscule initiale passe mal dans un nom accessible lu à
// voix haute ; le texte visible, lui, reste en bas de casse comme le reste du
// pied de page.
const NOMS: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
};
---

<footer class="pied">
  <span>&copy; {new Date().getFullYear()} {identite.nom}</span>
  <nav class="pied__contact" aria-label="Profils">
    {
      contact.map((ligne) => (
        <a href={ligne.lien} rel="me noopener" title={ligne.valeur}>
          {/* Le SVG est décoratif : le nom accessible du lien vient du texte
              qui suit, donc pas de <title> ni de rôle image à l'intérieur. */}
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d={LOGOS[ligne.cle]} />
          </svg>
          {NOMS[ligne.cle] ?? ligne.cle}
        </a>
      ))
    }
  </nav>
</footer>

<style>
  .pied {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.75rem var(--marge);
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--dim);
  }

  /* Le libellé plutôt que l'URL : une adresse complète en pied de page fait
     deux lignes sur mobile pour aucun gain. Elle reste lisible au survol via
     `title`, et dans la barre d'état du navigateur avant le clic. */
  .pied__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .pied__contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    color: var(--dim);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  /* Le logo suit la couleur du texte via `fill: currentColor`, y compris au
     survol : une seule règle repeint les deux. */
  .pied__contact a:hover {
    color: var(--signal);
    border-color: var(--signal);
  }

  /* Sans cette ligne, la boîte en ligne du SVG réserve la place d'un jambage
     sous la ligne de base et décale le logo vers le haut du libellé. */
  .pied__contact svg {
    display: block;
    flex: none;
  }
</style>
