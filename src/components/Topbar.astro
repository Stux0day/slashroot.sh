---
// Barre supérieure commune à tout le site : identité à gauche, dossiers
// d'articles au centre, sections et bascule de thème à droite.
//
// Les liens de sections pointent vers `/#ancre` et non `#ancre` : depuis une
// page d'article, une ancre nue ne mènerait nulle part.
import { type CollectionEntry, getCollection } from 'astro:content';
import { certifs, dossiers as dossiersDeclares, identite } from '../data/site';

let tousLesArticles: CollectionEntry<'blog'>[] = [];
try {
  tousLesArticles = await getCollection('blog');
} catch {
  tousLesArticles = [];
}

const parDateDecroissante = (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
  (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0);

// Deux niveaux sont lus dans l'arborescence de src/content/blog :
//   os/article.md         -> branche directe du menu _OS
//   os/Debian/article.md  -> branche fille du nœud « Debian/ »
// Plus profond (os/Debian/x/article.md), l'article est rattaché à Debian.
// L'ordre et les libellés du premier niveau viennent de site.ts ; un dossier
// présent sur le disque mais non déclaré s'ajoute à la fin, pour qu'un ajout
// de contenu ne passe jamais silencieusement à la trappe.
//
// Rappel : une collection indexe des fichiers, pas des répertoires. Un dossier
// sans aucun .md est invisible ici — il n'y a rien à lister.
const MAX_PAR_LISTE = 6;

/** Regroupe des articles par un segment de leur chemin. */
const regrouperPar = (articles: CollectionEntry<'blog'>[], indice: number) =>
  articles.reduce((acc, article) => {
    const segments = article.id.split('/');
    if (segments.length < indice + 2) return acc;
    const cle = segments[indice];
    acc.set(cle, [...(acc.get(cle) ?? []), article]);
    return acc;
  }, new Map<string, CollectionEntry<'blog'>[]>());

/** Trie par date et coupe à MAX_PAR_LISTE, en gardant le compte total. */
const enListe = (articles: CollectionEntry<'blog'>[]) => ({
  articles: [...articles].sort(parDateDecroissante).slice(0, MAX_PAR_LISTE),
  total: articles.length,
});

type Sous = { nom: string; articles: CollectionEntry<'blog'>[]; total: number };
type LigneSimple = {
  prefixe: string;
  libelle: string;
  href?: string;
  type: 'article' | 'reste';
};
type LigneNoeud = {
  prefixe: string;
  libelle: string;
  type: 'noeud';
  enfants: LigneSimple[];
};
type Ligne = LigneSimple | LigneNoeud;

/** Construit les lignes d'un dossier, préfixées par des connecteurs à la
 *  manière de la commande `tree`. Le connecteur dépend uniquement de la
 *  position : « └─ » pour le dernier élément d'un niveau, « ├─ » sinon. Un
 *  sous-dossier porte ses enfants (préfixés « │ » pour prolonger la
 *  verticale) plutôt que de les aplatir : c'est ce qui permet au gabarit de
 *  les replier dans un <details>. */
const construireArbre = (
  racine: { articles: CollectionEntry<'blog'>[]; total: number },
  sousDossiers: Sous[],
): Ligne[] => {
  const entrees = [
    ...racine.articles.map((article) => ({ type: 'article' as const, article })),
    ...(racine.total > racine.articles.length
      ? [{ type: 'reste' as const, nombre: racine.total - racine.articles.length }]
      : []),
    ...sousDossiers.map((sous) => ({ type: 'noeud' as const, sous })),
  ];

  return entrees.map((entree, i): Ligne => {
    const dernier = i === entrees.length - 1;
    const branche = dernier ? '└─ ' : '├─ ';
    const verticale = dernier ? '   ' : '│  ';

    if (entree.type === 'article') {
      return {
        prefixe: branche,
        libelle: entree.article.data.title,
        href: `/blog/${entree.article.id}/`,
        type: 'article',
      };
    }

    if (entree.type === 'reste') {
      return { prefixe: branche, libelle: `+ ${entree.nombre} autre(s)`, type: 'reste' };
    }

    const { sous } = entree;
    const tronque = sous.total > sous.articles.length;

    const enfants: LigneSimple[] = sous.articles.map((article, j) => ({
      prefixe: verticale + (!tronque && j === sous.articles.length - 1 ? '└─ ' : '├─ '),
      libelle: article.data.title,
      href: `/blog/${article.id}/`,
      type: 'article',
    }));

    if (tronque) {
      enfants.push({
        prefixe: `${verticale}└─ `,
        libelle: `+ ${sous.total - sous.articles.length} autre(s)`,
        type: 'reste',
      });
    }

    return { prefixe: branche, libelle: `${sous.nom}/`, type: 'noeud', enfants };
  });
};

const parDossier = regrouperPar(tousLesArticles, 0);

const nonDeclares = [...parDossier.keys()]
  .filter((id) => !dossiersDeclares.some((d) => d.id === id))
  .sort((a, b) => a.localeCompare(b, 'fr'))
  .map((id) => ({ id, libelle: id }));

const dossiers = [...dossiersDeclares, ...nonDeclares].map(({ id, libelle }) => {
  const entrees = parDossier.get(id) ?? [];

  // Profondeur 2 = article posé directement dans le dossier.
  const racine = entrees.filter((a) => a.id.split('/').length === 2);

  // Astro minuscule les identifiants : le dossier « Debian » arrive en
  // « debian ». On remet une capitale initiale faute de pouvoir retrouver
  // la casse d'origine.
  const sousDossiers = [...regrouperPar(entrees, 1).entries()]
    .sort(([a], [b]) => a.localeCompare(b, 'fr'))
    .map(([nom, articles]) => ({
      nom: nom.charAt(0).toUpperCase() + nom.slice(1),
      ...enListe(articles),
    }));

  return {
    id,
    libelle,
    lignes: construireArbre(enListe(racine), sousDossiers),
    totalDossier: entrees.length,
  };
});
---

<header class="topbar">
  <a class="topbar__id" href="/">{identite.service}</a>

  <nav class="topbar__dossiers" aria-label="Dossiers d'articles">
    {
      dossiers.map((dossier) => (
        <div class="dossier">
          {/* Un clic simple n'ouvre rien : c'est :hover/:focus-visible qui
              pilote l'affichage, donc souris, clavier et tactile fonctionnent
              sans JavaScript. Le double-clic est la seule action portée par
              ce bouton : il déplie/replie tous les sous-dossiers d'un coup
              (voir le script en bas de fichier). */}
          <button class="dossier__nom" type="button" data-dossier-tout>{dossier.libelle}</button>
          <ul class="dossier__menu">
            {dossier.lignes.map((ligne) =>
              ligne.type === 'noeud' ? (
                <li class="arbre-groupe">
                  {/* <details> ouvre/replie le sous-dossier sans JavaScript ;
                      le résumé entier reste cliquable, touche Entrée/Espace
                      comprise au clavier. Fermé par défaut : les sous-dossiers
                      ne s'affichent qu'à la demande. */}
                  <details>
                    <summary class="arbre arbre--noeud">
                      <span class="arbre__branche" aria-hidden="true">
                        {ligne.prefixe}
                      </span>
                      <span class="arbre__libelle">{ligne.libelle}</span>
                    </summary>
                    <ul class="arbre__enfants">
                      {ligne.enfants.map((enfant) => (
                        <li class={`arbre arbre--${enfant.type}`}>
                          <span class="arbre__branche" aria-hidden="true">
                            {enfant.prefixe}
                          </span>
                          {enfant.href ? (
                            <a href={enfant.href}>{enfant.libelle}</a>
                          ) : (
                            <span class="arbre__libelle">{enfant.libelle}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </details>
                </li>
              ) : (
                <li class={`arbre arbre--${ligne.type}`}>
                  {/* Les connecteurs sont décoratifs : masqués aux lecteurs
                      d'écran, qui n'ont que faire des caractères de dessin. */}
                  <span class="arbre__branche" aria-hidden="true">
                    {ligne.prefixe}
                  </span>
                  {ligne.href ? (
                    <a href={ligne.href}>{ligne.libelle}</a>
                  ) : (
                    <span class="arbre__libelle">{ligne.libelle}</span>
                  )}
                </li>
              ),
            )}
            {dossier.totalDossier === 0 && (
              <li class="arbre arbre--reste">
                <span class="arbre__branche" aria-hidden="true">└─ </span>
                <span class="arbre__libelle">dossier vide</span>
              </li>
            )}
          </ul>
        </div>
      ))
    }
  </nav>

  <nav class="topbar__nav" aria-label="Sections du site">
    <a href="/#stack">stack</a>
    <a href="/#travaux">travaux</a>
    {certifs.length > 0 && <a href="/#certifs">certifs</a>}
    {/* Bouton sans texte : l'aria-label porte seul le nom accessible, et le
        title donne l'équivalent au survol pour qui n'utilise pas de lecteur
        d'écran. Les deux sont donc obligatoires ici, pas décoratifs. */}
    <button
      id="bascule-theme"
      class="bascule"
      type="button"
      aria-label="Changer de thème"
      title="Changer de thème"
    >
      <span class="bascule__clair">☀</span>
      <span class="bascule__sombre">☾</span>
    </button>
  </nav>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    /* Trois zones : identité à gauche, dossiers au centre, sections à
       droite. Les 1fr symétriques centrent la colonne du milieu sur la
       page, indépendamment de la largeur des deux autres. */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem var(--marge);
    border-bottom: 1px solid var(--rule);
    background: var(--voile);
    backdrop-filter: blur(8px);
    font-family: var(--mono);
    font-size: 0.78rem;
  }

  /* Identité en Rubik Glitch : lettres volontairement décalées. Illisible en
     dessous d'environ 1rem, d'où le plancher du clamp. La casse d'origine est
     conservée — « Flynnhub.system » est un nom de domaine, le passer en
     capitales comme le reste de la barre lui ferait perdre cette lecture. */
  .topbar__id {
    min-width: 0;
    color: var(--text);
    font-family: var(--font-rubik-glitch), var(--mono);
    font-size: clamp(0.95rem, 1.25vw, 1.15rem);
    line-height: 1;
    text-decoration: none;
  }

  /* Rubik Glitch n'a pas le glyphe U+25CF : sans cette ligne, le rond partirait
     dans une police de repli et changerait de taille avec elle. */
  .topbar__id::before {
    content: '● ';
    color: var(--signal);
    font-family: var(--mono);
  }

  /* Gouttières resserrées depuis le passage à Rubik Glitch : son dessin est
     nettement plus large que la précédente display, et les trois zones de la
     barre tiennent juste sur une ligne. Chaque gouttière économisée est de la
     marge gagnée avant que la colonne du centre ne heurte celle de droite. */
  .topbar__dossiers {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
  }

  .topbar__nav {
    display: flex;
    align-items: center;
    justify-self: end;
    min-width: 0;
    gap: 0.9rem;
  }

  /* Même police et même encre que les dossiers du centre : ces liens restent un
     cran en dessous par la taille, pas par un gris plus clair. Les teinter en
     --dim les rendait délavés de jour pour un gain de hiérarchie que l'échelle
     donne déjà. Le plancher du clamp est à 1rem : en dessous, le décalage des
     lettres de Rubik Glitch cesse d'être lisible.

     Les libellés sont en minuscules dans le markup ; Zen Tokyo Zoo, qui les
     rendait auparavant, ne dessine que des capitales. text-transform reprend
     donc à sa charge ce que la police faisait implicitement.

     Le sélecteur vise les liens et non le conteneur, pour que la bascule de
     thème garde sa chasse — Rubik Glitch n'a ni ☀ ni ☾ et les ferait tomber
     dans une police de repli. */
  .topbar__nav a {
    color: var(--text);
    font-family: var(--font-rubik-glitch), var(--mono);
    font-size: clamp(1rem, 1.1vw, 1.05rem);
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
  }

  .topbar__nav a:hover {
    color: var(--signal);
  }

  /* ---------- Dossiers ---------- */
  .dossier {
    position: relative;
    /* Temps pendant lequel le menu reste ouvert après que la souris
       l'a quitté, pour laisser le temps d'aller cliquer. */
    --delai-fermeture: 1s;
  }

  /* Les noms de dossiers reprennent la Rubik Glitch de l'identité : la barre
     parle d'une seule voix. Elle remplace Zen Tokyo Zoo, une display évidée à
     traits fins qui posait deux problèmes — ses traits maigrissaient sur fond
     clair et la rendaient délavée de jour, et son dessin très large faisait
     déborder la colonne centrale sur les liens de droite.

     Rubik Glitch est plus étroite, mais reste une display : ces libellés sont
     descendus de 1.7rem à 1.2rem, sans quoi la colonne du milieu déborderait à
     nouveau. Le plancher reste au-dessus de 1rem, seuil en dessous duquel le
     décalage des lettres cesse d'être lisible.

     `font: inherit` remet d'abord tout à l'état de la barre, donc la famille
     et la taille se redéclarent après lui, jamais avant. line-height:1 empêche
     la hauteur de la barre de bouger. Le contenu des menus déroulants reste en
     chasse fixe — c'est lui qui aligne les branches « ├─ ». */
  .dossier__nom {
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    font-family: var(--font-rubik-glitch), var(--mono);
    font-size: clamp(1rem, 1.1vw, 1.1rem);
    line-height: 1;
    letter-spacing: 0;
    cursor: pointer;
  }

  /* :focus-within laisserait le nom en rouge après un clic. Le dernier
     sélecteur garde la mise en évidence quand le focus clavier est descendu
     dans les articles du menu. */
  .dossier:hover .dossier__nom,
  .dossier__nom:focus-visible,
  .dossier:has(.dossier__menu:focus-within) .dossier__nom {
    color: var(--signal);
  }

  .dossier__menu {
    position: absolute;
    top: calc(100% + 0.85rem);
    left: 0;
    z-index: 20;
    /* max-content pour que les branches ne soient jamais rognées ; le
       plafond évite qu'un titre à rallonge déborde de l'écran. */
    width: max-content;
    min-width: 16rem;
    max-width: min(90vw, 30rem);
    margin: 0;
    padding: 0.4rem 0;
    border: 1px solid var(--rule);
    background: var(--panel);
    list-style: none;
    /* visibility plutôt que display : display:none retirerait les liens
       de l'ordre de tabulation avant que le focus puisse ouvrir. */
    visibility: hidden;
    opacity: 0;
    /* Ce délai ne s'applique qu'à la fermeture : la règle :hover
       ci-dessous le remet à zéro, donc l'ouverture reste instantanée.
       visibility bascule après le fondu, pas pendant. */
    transition:
      opacity 0.15s ease var(--delai-fermeture),
      visibility 0s linear calc(var(--delai-fermeture) + 0.15s);
  }

  /* Pont invisible au-dessus du menu : sans lui, la souris qui descend
     vers un article traverse un vide, sort du .dossier, et tout se
     referme avant d'avoir pu cliquer. */
  .dossier__menu::before {
    content: '';
    position: absolute;
    inset: -0.85rem 0 auto 0;
    height: 0.85rem;
  }

  /* Trois façons d'ouvrir :
     - la souris survole le dossier ;
     - le clavier atteint le nom — :focus-visible et non :focus-within,
       car ce dernier reste vrai après un clic de souris et laissait le
       menu bloqué ouvert ;
     - le focus est déjà descendu dans le menu, pour pouvoir le parcourir
       au clavier une fois le nom quitté. */
  .dossier:hover .dossier__menu,
  .dossier__nom:focus-visible ~ .dossier__menu,
  .dossier__menu:focus-within {
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }

  /* Tant que le curseur est quelque part dans la zone des dossiers, seul
     celui qu'il occupe reste ouvert : les autres se ferment sur-le-champ,
     sans fondu — c'est le fondu qui les faisait se superposer.
     Le délai d'une seconde ne joue donc que lorsqu'on quitte la zone
     entièrement, c'est-à-dire quand on descend cliquer sur un article. */
  .topbar__dossiers:hover .dossier:not(:hover) .dossier__menu:not(:focus-within) {
    visibility: hidden;
    opacity: 0;
    transition: none;
  }

  /* Un clic en dehors de tous les dossiers (voir le script en bas de
     fichier) supprime ponctuellement le délai de fermeture : la souris a
     déjà quitté le dossier à ce moment-là, donc le menu est de toute façon
     déjà en train de se refermer — seule l'attente d'une seconde change. */
  .dossier__menu.dossier__menu--fermer-immediat {
    transition: none;
  }

  /* ---------- Lignes d'arborescence ---------- */
  .arbre {
    display: flex;
    align-items: baseline;
    padding: 0 0.9rem;
    white-space: nowrap;
  }

  /* Les connecteurs doivent rester en chasse fixe et conserver leurs
     espaces, sinon l'alignement vertical des branches se casse. */
  .arbre__branche {
    flex: none;
    color: var(--dim);
    white-space: pre;
    user-select: none;
  }

  .arbre a,
  .arbre__libelle {
    display: block;
    overflow: hidden;
    padding: 0.3rem 0;
    color: var(--text);
    text-decoration: none;
    text-overflow: ellipsis;
  }

  .arbre--article:hover .arbre__branche,
  .arbre:focus-within .arbre__branche {
    color: var(--signal);
  }

  .arbre--article:hover a,
  .arbre a:focus-visible {
    color: var(--signal);
  }

  /* Le nœud d'un sous-dossier est un repère, pas un lien. */
  .arbre--noeud .arbre__libelle {
    color: var(--text);
  }

  .arbre--reste .arbre__libelle {
    opacity: 0.7;
  }

  /* ---------- Sous-dossiers pliables ---------- */
  /* Pas d'icône visible : le résumé entier reste cliquable, sans marqueur
     à droite. On masque quand même le triangle natif du <summary>, dont le
     dessin ne suit pas l'esthétique du reste de la barre. Les deux
     sélecteurs sont nécessaires : Firefox suit `list-style`, WebKit son
     propre pseudo-élément. */
  summary.arbre--noeud {
    list-style: none;
    cursor: pointer;
  }

  summary.arbre--noeud::-webkit-details-marker {
    display: none;
  }

  summary.arbre--noeud:hover .arbre__branche,
  summary.arbre--noeud:focus-visible .arbre__branche {
    color: var(--signal);
  }

  .arbre__enfants {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- Bascule jour / nuit ---------- */
  /* Le symbole est seul depuis que le libellé a sauté : il porte tout le sens
     visuel du bouton, donc il monte nettement au-dessus du reste de la barre.
     line-height:1 empêche cette taille de creuser la hauteur du bandeau. */
  /* La boîte est carrée et fixée en em : sans elle, elle épouserait la chasse
     du glyphe affiché, et le croissant ☾ est nettement plus étroit que le
     soleil ☀ — la cible de clic rétrécissait donc en thème clair, et le bouton
     changeait de largeur à chaque bascule. */
  .bascule {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5em;
    /* La hauteur reste à 1 em : au-delà, c'est la bascule qui deviendrait
       l'élément le plus haut de la grille et le bandeau s'épaissirait. */
    height: 1em;
    padding: 0;
    border: 0;
    background: none;
    /* Même encre que les dossiers et les liens : --dim laissait le symbole en
       retrait alors qu'il porte seul le sens du bouton. --text le fonce de jour
       et l'éclaircit de nuit d'un seul réglage. */
    color: var(--text);
    font-family: var(--mono);
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }

  /* Le glyphe reste à 24 px pour ne pas creuser la hauteur du bandeau, mais un
     pointeur — un doigt surtout — vise plus large que ça. Ce calque débordant
     porte la zone sensible à ~44 px sans rien déplacer : hors flux, il ne
     participe pas à la mise en page, et les clics qu'il reçoit reviennent au
     bouton qui le contient. */
  .bascule::after {
    content: '';
    position: absolute;
    inset: -0.45em -0.25em;
  }

  .bascule:hover {
    color: var(--signal);
  }

  /* Le libellé annonce le thème vers lequel on bascule. Piloté en CSS
     plutôt qu'en JS : correct dès le premier rendu, sans script. */
  .bascule__sombre {
    display: none;
  }

  :root[data-theme='clair'] .bascule__clair {
    display: none;
  }

  :root[data-theme='clair'] .bascule__sombre {
    display: inline;
  }

  /* Rubik Glitch est large : à partir d'environ 1320px, la colonne du centre
     vient heurter celle de droite. Les 1fr symétriques y sont pour beaucoup —
     ils centrent le bloc du milieu sur la page sans tenir compte du fait que la
     zone de droite est bien plus encombrante que l'identité à gauche.

     Sur cette plage, on renonce donc au centrage exact : les colonnes latérales
     passent en `auto` et prennent la largeur de leur contenu, le centre reçoit
     ce qui reste et s'y centre. Le bloc du milieu s'en trouve légèrement décalé
     à droite du centre de la page, mais le chevauchement devient impossible par
     construction plutôt que par réglage de tailles. */
  @media (max-width: 1400px) {
    .topbar {
      grid-template-columns: auto 1fr auto;
    }
  }

  @media (max-width: 1200px) {
    /* Les trois zones ne tiennent plus sur une ligne : on empile et on
       centre, plutôt que de laisser les dossiers déborder. Ce seuil était à
       640px du temps de Zen Tokyo Zoo ; Rubik Glitch, plus large, épuise la
       ligne bien plus tôt — et son dessin décalé cesse d'être lisible en
       dessous d'environ 1rem, on ne peut donc pas la réduire davantage. */
    .topbar {
      grid-template-columns: 1fr;
      row-gap: 0.6rem;
      justify-items: center;
    }

    .topbar__dossiers,
    .topbar__nav {
      flex-wrap: wrap;
      justify-content: center;
      justify-self: center;
      gap: 1rem;
    }

    /* Un menu de 16rem déborderait de l'écran ; on le contraint. */
    .dossier__menu {
      min-width: 0;
      width: max-content;
      max-width: min(78vw, 16rem);
    }
  }
</style>

<script>
  document.getElementById('bascule-theme')?.addEventListener('click', () => {
    const suivant = document.documentElement.dataset.theme === 'clair' ? 'sombre' : 'clair';
    document.documentElement.dataset.theme = suivant;
    try {
      localStorage.setItem('theme', suivant);
    } catch {
      /* stockage indisponible : la bascule reste valable pour la session */
    }
  });

  // Double-clic sur le titre du menu = tout déplier/replier d'un coup.
  // Tout ouvert -> tout replier ; sinon (fermé ou mixte) -> tout déplier.
  // L'état est relu dans le DOM à chaque double-clic plutôt que mémorisé,
  // pour rester juste même après un pliage individuel d'un sous-dossier.
  document.querySelectorAll('[data-dossier-tout]').forEach((bouton) => {
    bouton.addEventListener('dblclick', () => {
      const details = [...(bouton.closest('.dossier')?.querySelectorAll('details') ?? [])];
      const toutOuvert = details.every((d) => d.open);
      details.forEach((d) => {
        d.open = !toutOuvert;
      });
    });
  });

  // Un clic hors de tout dossier a déjà fait perdre le survol/focus qui
  // gardait le menu ouvert ; seul le délai de fermeture (--delai-fermeture)
  // retarde encore sa disparition. On le court-circuite le temps d'un
  // repaint, puis on le restitue pour que la fermeture par simple perte de
  // survol continue de bénéficier de son fondu habituel.
  document.addEventListener('click', (evenement) => {
    if (evenement.target instanceof Element && evenement.target.closest('.dossier')) return;
    const menus = document.querySelectorAll('.dossier__menu');
    menus.forEach((menu) => menu.classList.add('dossier__menu--fermer-immediat'));
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        menus.forEach((menu) => menu.classList.remove('dossier__menu--fermer-immediat'));
      });
    });
  });
</script>
