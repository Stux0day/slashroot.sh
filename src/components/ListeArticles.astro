---
// Liste d'articles : titre, description et métadonnées. Une seule colonne
// quand la place manque ; sur deux puis trois colonnes quand le bloc qui la
// contient s'élargit (requêtes de conteneur : c'est la largeur réellement
// disponible qui compte, pas celle de la fenêtre).
// Toute l'entrée est cliquable, mais un seul lien est annoncé aux lecteurs
// d'écran (celui du titre).
import { type Article, dateCourte, dateISO, dossierDe, libelleDossier } from '../lib/articles';
import Icon from './Icon.astro';
import Tiret from './Tiret.astro';

interface Props {
	articles: Article[];
	/** Affiche le dossier de chaque article (listes multi-dossiers). */
	avecDossier?: boolean;
}

const { articles, avecDossier = false } = Astro.props;
---

<div class="entrees-cadre">
	<ol class="entrees" role="list">
		{
			articles.map((article) => (
				<li class="entree">
					<a class="entree__lien" href={`/blog/${article.id}/`}>
						<span class="entree__titre">
							{article.data.title}
							<Icon nom="fleche-droite" taille={16} />
						</span>
						{article.data.description && (
							<span class="entree__description">{article.data.description}</span>
						)}
					</a>
					<p class="entree__meta etiquette">
						{avecDossier && (
							<span>
								<Tiret texte={libelleDossier(dossierDe(article))} />
							</span>
						)}
						<time datetime={dateISO(article.data.pubDate)}>{dateCourte(article.data.pubDate)}</time>
					</p>
				</li>
			))
		}
	</ol>
</div>

<style>
	.entrees-cadre {
		container-type: inline-size;
	}

	.entrees {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		column-gap: var(--colonnes-gap);
		margin: 0;
		border-bottom: 1px solid var(--filet);
	}

	.entree {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: baseline;
		align-content: start;
		gap: 0.4rem 2rem;
		padding-block: 1.15rem;
		border-top: 1px solid var(--filet);
	}

	.entree__lien {
		display: grid;
		gap: 0.3rem;
		text-decoration: none;
	}

	/* Étend la zone cliquable du lien à toute l'entrée. */
	.entree__lien::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.entree__titre {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5rem;
		font-size: var(--t-l);
		font-weight: 650;
		line-height: 1.3;
		transition: color var(--duree) var(--courbe);
	}

	/* :global : le <svg> est rendu par Icon.astro, hors de la portée des
	   styles de ce composant. */
	.entree__titre :global(svg) {
		flex: none;
		align-self: center;
		opacity: 0;
		transform: translateX(-6px);
		transition:
			opacity var(--duree) var(--courbe),
			transform var(--duree) var(--courbe);
	}

	.entree__description {
		color: var(--encre-2);
		font-size: 0.95em;
		line-height: 1.5;
	}

	.entree__meta {
		display: flex;
		gap: 1.25rem;
		margin: 0;
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	.entree:hover .entree__titre {
		color: var(--accent-texte);
	}

	.entree:hover .entree__titre :global(svg) {
		opacity: 1;
		transform: none;
	}

	/* Colonne étroite : les métadonnées passent au-dessus du titre, qui garde
	   ainsi toute la largeur. */
	@container (max-width: 40rem) {
		.entree {
			grid-template-columns: minmax(0, 1fr);
		}

		.entree__meta {
			order: -1;
		}
	}

	/* Bloc large : plusieurs colonnes, chaque entrée devient une fiche
	   (métadonnées, titre, description). */
	@container (min-width: 64rem) {
		.entrees {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.entree {
			grid-template-columns: minmax(0, 1fr);
			padding-block: 1.25rem 1.5rem;
		}

		.entree__meta {
			order: -1;
		}
	}

	@container (min-width: 110rem) {
		.entrees {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
