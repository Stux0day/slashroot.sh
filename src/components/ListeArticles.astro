---
// Liste d'articles en lignes : sous-dossier éventuel, titre, date.
// Partagée par l'index des articles (/blog/) et les pages de dossier.
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	articles: CollectionEntry<'blog'>[];
}

const { articles } = Astro.props;

// os/Debian/x -> « debian/ » ; systeme/apache -> pas de sous-dossier.
const sousDossier = (id: string) => {
	const segments = id.split('/');
	return segments.length > 2 ? `${segments[1]}/` : null;
};
---

<ul class="liste">
	{
		articles.map((article) => (
			<li class="ligne">
				<a href={`/blog/${article.id}/`}>
					{sousDossier(article.id) && <span class="sous">{sousDossier(article.id)}</span>}
					<span class="titre">{article.data.title}</span>
				</a>
				<span class="date">
					<FormattedDate date={article.data.pubDate} />
				</span>
			</li>
		))
	}
</ul>

<style>
	.liste {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.ligne {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--rule);
	}

	.ligne a {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		min-width: 0;
		color: var(--text);
		text-decoration: none;
	}

	.ligne a:hover,
	.ligne a:focus-visible {
		color: var(--signal);
	}

	.sous {
		flex: none;
		color: var(--dim);
		font-family: var(--mono);
		font-size: 0.82rem;
	}

	/* Le titre passe à la ligne plutôt que d'être tronqué par « … » : un titre
	   coupé cache justement ce qui distingue deux articles voisins. */
	.titre {
		min-width: 0;
		font-family: var(--sans);
		font-size: 1.02rem;
		line-height: 1.4;
		overflow-wrap: break-word;
	}

	.date {
		flex: none;
		color: var(--dim);
		font-family: var(--mono);
		font-size: 0.78rem;
	}

	@media (max-width: 600px) {
		.ligne {
			flex-direction: column;
			gap: 0.35rem;
		}
	}
</style>
